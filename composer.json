{
    "name": "vitaliicherepanov/php-llama-bench",
    "description": "PHP performance benchmarks inspired by llama.cpp design",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-ffi": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "PhpLlamaBench\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.0"
        }
    },
    "minimum-stability": "stable"
}
